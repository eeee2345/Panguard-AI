{
  "name": "@panguard-ai/core",
  "version": "1.8.26",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/panguard-ai/panguard-ai"
  },
  "homepage": "https://panguard.ai",
  "type": "module",
  "description": "Core shared modules for Panguard AI / Panguard 安全平台核心共用模組",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    },
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./signing": {
      "import": "./dist/signing/index.js",
      "types": "./dist/signing/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsc --build --watch",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "i18next": "^24.2.2",
    "js-yaml": "^4.1.0",
    "zod": "^3.24.0"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.30.0",
    "openai": ">=4.70.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/i18next": "^13.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.14.0",
    "typescript": "~5.7.3"
  }
}
